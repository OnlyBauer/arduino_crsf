# Static analysis for CRSFv3, checked by tools/ci.sh lint and the lint stage in
# .gitlab-ci.yml.
#
# The purpose of this job is explicitly regression protection, not bug hunting:
# at the state it was introduced in, the enabled checks report nothing over this
# library's own code (CRSFv3.cpp/.h, the tests, the Arduino mock). The job is
# therefore blocking from the start and not allow_failure: it should go red as
# soon as the next patch brings something new in.
#
# WarningsAsErrors is deliberately set to everything that enables checks at all.
# A clang-tidy run without it returns exit code 0 even on warnings and would be
# silently useless in CI.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -cert-err58-cpp

WarningsAsErrors: '*'

# Only this repository's own headers. The vendored core is c_crsf's code, is
# checked there, and two clang versions over the same file produce nothing but
# phantom findings in the long run. For this library there is more to it: the
# core is compiled as C++ here, and misc-const-correctness then reports things
# in crsf_codec.h that do not hold in C at all -- the same reason the check is
# switched off below for the whole repository.
HeaderFilterRegex: '(CRSFv3|crsf_arduino_conf)\.h$'

# A reason for every single exclusion above -- without this list, nobody would
# know next time whether a check is missing for a good reason or out of
# convenience:
#
# bugprone-easily-swappable-parameters
#   Reports every function with two adjacent parameters of the same type. For a
#   wire-protocol API that is the normal case and unavoidable:
#   crsf_build_frame(dst, cap, addr, type) has four uint8_t in a row, because
#   the format has four bytes in a row.
#
# bugprone-narrowing-conversions
#   For a wire protocol that constantly converts between widths, this check
#   permanently reports conversions that a clamp already performed has long
#   made safe; it cannot see such a clamp.
#
# clang-analyzer-optin.performance.Padding
#   Reports structures that would be smaller with a different field order. For
#   the payload structures the order is dictated by the wire format and must
#   precisely not be sorted by size.
#
# cert-err33-c
#   Requires checking the return value of printf & co. In the test suites and
#   the examples that is pointless.
#
# cert-dcl37-c / cert-dcl51-cpp
#   Reserved identifiers. Fires on the include guards (CRSF_..._H), which are
#   not reserved.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#   Requires memcpy_s / memset_s from C11 Annex K. That is optional, and none of
#   the C libraries in question here -- newlib, glibc, avr-libc -- provides it.
#
# misc-include-cleaner
#   Requires including every name used directly. Would dilute rather than
#   improve the deliberately maintained include structure of the vendored core,
#   and is c_crsf's decision anyway, not this repository's.
#
# misc-no-recursion
#   There is no recursion; the check is merely expensive.
#
# misc-const-correctness
#   The vendored core is C and is checked as such in c_crsf. Here it
#   additionally goes through a C++ compiler, because CRSFv3.cpp includes it
#   directly, and this check then reports C idioms that do not hold in C at all
#   -- above all the scalar variables the CHECK_EQ_* macros from test_util.h
#   create. test_util.h is taken over unchanged from c_crsf and is not adjusted
#   for a C++ quirk that exists in no other repository of this project.
#
# misc-use-anonymous-namespace
#   Requires anonymous namespaces instead of internal linkage via `static`.
#   `static` for file-local functions and variables is the idiom every single
#   test file in every one of the four repositories uses -- the other three are
#   pure C, where anonymous namespaces do not exist. Keeping this one C++ file
#   consistent with the others weighs more than a Cpp Core Guidelines preference
#   with no effect on behaviour or readability.
#
# cert-err58-cpp
#   Requires that the constructor of an object with static storage duration
#   cannot throw. Here that concerns test mocks like MockSerial exclusively,
#   whose constructor calls reset() -- plain field assignments, no allocation.
#   No repository of this project uses or enables exception handling; it is a
#   target for microcontrollers.
