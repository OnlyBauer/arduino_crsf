# Statische Analyse für CrsfPort, geprüft von tools/ci.sh lint und der Stufe
# lint in .gitlab-ci.yml.
#
# Der Zweck dieses Jobs ist ausdrücklich Regressionsschutz, nicht Fundsuche: auf
# dem Stand, an dem er eingeführt wurde, melden die aktivierten Prüfungen über
# den eigenen Code dieser Bibliothek (CrsfPort.cpp/.h, die Tests, die
# Arduino-Attrappe) nichts. Der Job ist deshalb von Anfang an blockierend und
# nicht allow_failure: er soll rot werden, sobald der nächste Patch etwas Neues
# einträgt.
#
# WarningsAsErrors steht bewusst auf allem, was Checks überhaupt aktiviert. Ein
# clang-tidy-Lauf ohne das gibt Exit-Code 0 auch bei Warnungen und wäre in CI
# stillschweigend nutzlos.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -cert-err58-cpp

WarningsAsErrors: '*'

# Nur die Header dieses Repositories. Der eingebettete Kern ist c_crsf's Code,
# wird dort geprüft, und zwei clang-Versionen über dieselbe Datei erzeugen auf
# Dauer nur Scheinbefunde. Bei dieser Bibliothek kommt hinzu, dass der Kern
# hier als C++ übersetzt wird: misc-const-correctness meldet dann in
# crsf_codec.h etwas, das in C gar nicht gilt — derselbe Grund, aus dem die
# Prüfung unten für das ganze Repository abgeschaltet ist.
HeaderFilterRegex: '(CrsfPort|crsf_arduino_conf)\.h$'

# Begründung für jede einzelne Abschaltung oben — ohne diese Liste wüsste beim
# nächsten Mal niemand mehr, ob eine Prüfung aus gutem Grund oder aus Bequem-
# lichkeit fehlt:
#
# bugprone-easily-swappable-parameters
#   Meldet jede Funktion mit zwei benachbarten Parametern gleichen Typs. Bei
#   einer Wire-Protokoll-API ist das der Normalfall und nicht zu vermeiden:
#   crsf_build_frame(dst, cap, addr, type) hat vier uint8_t hintereinander,
#   weil das Format vier Bytes hintereinander hat.
#
# bugprone-narrowing-conversions
#   Bei einem Wire-Protokoll, das ständig zwischen Breiten wandelt, meldet
#   diese Prüfung dauerhaft Konvertierungen, die durch eine bereits erfolgte
#   Klemmung längst sicher sind; sie kann eine solche Klemmung nicht sehen.
#
# clang-analyzer-optin.performance.Padding
#   Meldet Strukturen, die durch eine andere Feldreihenfolge kleiner würden.
#   Bei den Payload-Strukturen ist die Reihenfolge durch das Wire-Format
#   vorgegeben und darf gerade nicht nach Größe sortiert werden.
#
# cert-err33-c
#   Verlangt, den Rückgabewert von printf & Co. zu prüfen. In den Testsuiten
#   und den Beispielen ist das sinnlos.
#
# cert-dcl37-c / cert-dcl51-cpp
#   Reservierte Bezeichner. Schlägt auf die Include-Wächter (CRSF_..._H) an,
#   die keine sind.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#   Verlangt memcpy_s / memset_s aus C11 Annex K. Die ist optional, und keine
#   der hier in Frage kommenden C-Bibliotheken -- newlib, glibc, avr-libc --
#   stellt sie bereit.
#
# misc-include-cleaner
#   Verlangt, jeden benutzten Namen direkt zu inkludieren. Würde die bewusst
#   gepflegte Include-Struktur des eingebetteten Kerns aufweichen, nicht
#   verbessern, und ist ohnehin c_crsf's Entscheidung, nicht diese hier.
#
# misc-no-recursion
#   Es gibt keine Rekursion; die Prüfung ist nur teuer.
#
# misc-const-correctness
#   Der eingebettete Kern ist C und wird in c_crsf als solches geprüft. Hier
#   läuft er zusätzlich durch einen C++-Compiler, weil CrsfPort.cpp ihn direkt
#   einbindet, und diese Prüfung meldet dann C-Idiome, die in C gar nicht
#   gelten -- vor allem die Skalarvariablen, die die CHECK_EQ_*-Makros aus
#   test_util.h anlegen. test_util.h ist unverändert aus c_crsf übernommen und
#   wird nicht wegen einer C++-Eigenheit angepasst, die in keinem anderen
#   Repository dieses Projekts existiert.
#
# misc-use-anonymous-namespace
#   Verlangt anonyme Namensräume statt interner Verknüpfung über `static`.
#   `static` für Datei-lokale Funktionen und Variablen ist das Idiom, das
#   jede einzelne Testdatei in jedem der vier Repositories verwendet -- die
#   übrigen drei sind reines C, wo anonyme Namensräume nicht existieren. Diese
#   eine C++-Datei stimmig zu den anderen zu halten wiegt schwerer als eine
#   Cpp-Core-Guidelines-Präferenz ohne Auswirkung auf Verhalten oder
#   Lesbarkeit.

# cert-err58-cpp
#   Verlangt, dass der Konstruktor eines Objekts mit statischer Speicherdauer
#   nicht werfen kann. Betrifft hier ausschließlich Testattrappen wie
#   MockSerial, deren Konstruktor reset() aufruft -- reine Feldzuweisungen,
#   keine Allokation. Kein Repository dieses Projekts verwendet oder aktiviert
#   Ausnahmebehandlung; es ist ein Ziel für Mikrocontroller.
