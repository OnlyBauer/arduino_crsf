# Static analysis for CRSFv3, run by tools/ci.sh lint.
#
# Regression protection, not bug hunting: the enabled checks report nothing on
# this library's own code today, so the job blocks from the start and should go
# red on the first patch that changes that. WarningsAsErrors is required --
# without it clang-tidy exits 0 on warnings and the job proves nothing.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-err58-cpp,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-const-correctness,
  -misc-use-anonymous-namespace

WarningsAsErrors: '*'

# Only this repository's own headers. The vendored core is checked in c_crsf,
# and it is compiled as C++ here, which makes some checks fire on C idioms.
HeaderFilterRegex: '(CRSFv3|crsf_arduino_conf)\.h$'

# Why each check above is off -- so the next reader knows it was a decision:
#
#   easily-swappable-parameters  A wire API has runs of same-typed bytes.
#   narrowing-conversions        Cannot see a clamp that already made it safe.
#   dcl37-c / dcl51-cpp          Fires on the CRSF_..._H include guards.
#   err33-c                      printf return values, in tests and examples.
#   err58-cpp                    Test mocks at static scope; we build without
#                                exceptions anyway.
#   Padding                      Payload field order is the wire format's.
#   insecureAPI...BufferHandling Wants C11 Annex K; newlib and avr-libc lack it.
#   include-cleaner              The vendored core's include structure is
#                                c_crsf's business.
#   no-recursion                 There is none; the check is just slow.
#   const-correctness            Reports C idioms the C++ pass invents, mainly
#                                in test_util.h, which is c_crsf's file.
#   use-anonymous-namespace      `static` is the idiom in all four sibling
#                                repositories, three of which are pure C.
