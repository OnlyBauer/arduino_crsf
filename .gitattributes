# Pin line endings. Developed on Windows, built in Linux containers; without
# this file it depends on the local core.autocrlf whether a commit carries CRLF.

* text=auto

*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.ino  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
Makefile text eol=lf
Doxyfile text eol=lf
VERSION  text eol=lf
NOTICE   text eol=lf
LICENSE  text eol=lf
c_crsf.pin text eol=lf
library.properties text eol=lf
.clang-format text eol=lf
.clang-tidy   text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# extras/vendor/golden_trace.txt is compared byte for byte against what a run
# produces; CRLF there fails for everyone but the developer, with a diff that
# looks like a real protocol error.
*.txt  text eol=lf

# keywords.txt needs real tabs. This line is only about line endings --
# .gitattributes cannot protect tabs, tools/ci.sh lint does.
keywords.txt text eol=lf

*.ps1  text eol=crlf

# The vendored core sits flat in src/, because Arduino 1.5 puts only src/ itself
# on the include path.
src/crsf_*.h linguist-vendored
src/crsf_*.c linguist-vendored
