# Format rules for CRSFv3, run by tools/ci.sh lint.
#
# This describes the style the repository already had. Measured against the
# stock styles, all fit badly: LLVM and Google rewrite ~130 % of lines, GNU and
# Mozilla >160 %, WebKit 28 %. The settings below leave 15 %.
#
# In one sentence: Linux braces, four spaces, star on the name, no auto-wrap.

BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

# No limit, so nothing already wrapped gets re-wrapped. The most important
# switch here: with a limit the tool reformats every expression to its own
# taste. Line length stays the author's business.
ColumnLimit: 0

BreakBeforeBraces: Linux

# uint8_t *out, not uint8_t* out.
PointerAlignment: Right
ReferenceAlignment: Right

# Own header first, then system. Not alphabetical.
SortIncludes: Never

# Inline, not None: with None each of the ~15 trivial accessors in CRSFv3.h
# becomes a four-liner, which makes the library's shop-window header unreadable.
# Inline keeps only in-class short methods on one line. The only deviation from
# the sibling repositories; clang-format has no separate C, so it cannot be
# scoped to C++ -- harmless, since this repository's own code is all C++.
AllowShortFunctionsOnASingleLine: Inline

# public:/private: at class level, not indented.
AccessModifierOffset: -4
AllowShortBlocksOnASingleLine: Always
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# (uint8_t)x, not (uint8_t) x.
SpaceAfterCStyleCast: false

IndentCaseLabels: false
IndentGotoLabels: false
IndentPPDirectives: None

# Do not force alignment: the code aligns `=` deliberately in some blocks and
# deliberately not in others. Where it is intended it sits under
# `clang-format off`.
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignAfterOpenBracket: Align
AlignOperands: Align

# The files are heavily commented, often with lists and tables. A reflow would
# take those apart.
ReflowComments: false

BinPackArguments: true
BinPackParameters: true

KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

InsertNewlineAtEOF: true
