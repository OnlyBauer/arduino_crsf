# Editor defaults matching .clang-format. Enforces nothing -- it only keeps an
# editor to the rules while you type, so tools/ci.sh lint has nothing to say.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,ino}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
# Make requires real tabs at the start of a recipe line.
indent_style = tab

[keywords.txt]
# The Arduino IDE splits on real tabs and silently ignores a line with spaces.
indent_style = tab

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break.
trim_trailing_whitespace = false
