# Editor defaults matching .clang-format. This file enforces nothing -- it only
# makes an editor keep to the rules while you type, rather than having
# tools/ci.sh lint complain about them afterwards. Read by VS Code, CLion, the
# Arduino IDE 2 and Visual Studio without an extension.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,ino}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
# Make requires real tabs at the start of a recipe line.
indent_style = tab

[keywords.txt]
# The Arduino IDE's parser splits on real tabs and silently ignores a line that
# uses spaces.
indent_style = tab

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
